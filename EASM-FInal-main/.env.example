# =====================================================================
#  EASM pipeline configuration template. Copy to .env and fill in.
#    cp .env.example .env
# =====================================================================

# PostgreSQL (EASM state layer)
POSTGRES_USER=easm
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=easm
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# n8n
# Generate the key once with: openssl rand -hex 24, then keep it stable.
N8N_ENCRYPTION_KEY=change-me-32-bytes-hex
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
GENERIC_TIMEZONE=Europe/Paris
N8N_METRICS=true

# Scanner microservice
SCANNER_URL=http://easm_scanner:5001

# Grafana (observability UI admin password)
GRAFANA_ADMIN_PASSWORD=change-me-strong

# Shodan recon enrichment (optional)
SHODAN_API_KEY=

# GitHub token for the subfinder GitHub source (optional)
GITHUB_TOKEN=

# Discord alerting
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/XXXX/YYYY

# SMTP (Gmail uses a 16-char App Password, not the account password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password
SMTP_SENDER=you@gmail.com
ALERT_EMAIL_TO=you@gmail.com

# Per-severity email routing
EMAIL_OWNER=owner@example.com
EMAIL_LOW=low@example.com
EMAIL_MEDIUM=medium@example.com
EMAIL_HIGH=high@example.com

# Jira Cloud
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=account-owning-the-token@example.com
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=EASM
JIRA_PROJECT_ID=10000
JIRA_TASK_ISSUETYPE_ID=10001
JIRA_SUBTASK_ISSUETYPE_ID=10002

# Per-severity Jira assignee account ids
JIRA_ACCT_OWNER=
JIRA_ACCT_LOW=
JIRA_ACCT_MEDIUM=
JIRA_ACCT_HIGH=

