[
  {
    "id": "easm-pg",
    "name": "EASM Postgres",
    "type": "postgres",
    "data": {
      "host": "postgres",
      "port": 5432,
      "database": "${POSTGRES_DB}",
      "user": "${POSTGRES_USER}",
      "password": "${POSTGRES_PASSWORD}",
      "ssl": "disable",
      "allowUnauthorizedCerts": false,
      "sshTunnel": false
    }
  },
  {
    "id": "easm-smtp",
    "name": "EASM SMTP",
    "type": "smtp",
    "data": {
      "user": "${SMTP_USER}",
      "password": "${SMTP_PASS}",
      "host": "${SMTP_HOST}",
      "port": ${SMTP_PORT},
      "secure": false,
      "disableStartTls": false
    }
  },
  {
    "id": "easm-jira",
    "name": "EASM Jira",
    "type": "jiraSoftwareCloudApi",
    "data": {
      "email": "${JIRA_EMAIL}",
      "apiToken": "${JIRA_API_TOKEN}",
      "domain": "${JIRA_BASE_URL}"
    }
  }
]
